{
  "name": "dreamshaderlang-language-support",
  "displayName": "DreamShaderLang Language Support",
  "description": "Language support for DreamShaderLang: 2.0 .dss sources, .dsi material instances and .dsp Custom Pass pipelines, and the 1.x .dsm materials, .dsf function files and .dsh shared headers.",
  "version": "2.0.0",
  "publisher": "typedreammoon",
  "author": {
    "name": "TypeDreamMoon",
    "url": "https://github.com/TypeDreamMoon"
  },
  "homepage": "https://dev.64hz.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/TypeDreamMoon/dreamshader-language-support"
  },
  "license": "MIT",
  "copyright": "Copyright (c) 2026 TypeDreamMoon. All rights reserved.",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "resources/icon.png",
  "keywords": [
    "dreamshaderlang",
    "dreamshader",
    "shader",
    "package",
    "unreal",
    "material",
    "dsm",
    "dsf",
    "dsh",
    "dss",
    "dsi",
    "dsp",
    "custom pass"
  ],
  "activationEvents": [
    "onLanguage:dreamshaderlang",
    "onView:dreamshader.bridgeDiagnostics",
    "onCommand:dreamshader.showBridgeDiagnostics",
    "onCommand:dreamshader.recompileCurrent",
    "onCommand:dreamshader.recompileAll",
    "onCommand:dreamshader.refreshBridgeDiagnostics",
    "onCommand:dreamshader.openBridgeDiagnosticLocation",
    "onCommand:dreamshader.cleanGeneratedShaders",
    "onCommand:dreamshader.showMaterialPreview",
    "onCommand:dreamshader.showMaterialDetails",
    "onCommand:dreamshader.installPackageFromGitHub",
    "onCommand:dreamshader.browsePackages",
    "onCommand:dreamshader.updatePackages",
    "onCommand:dreamshader.removePackage",
    "onCommand:dreamshader.openPackagesFolder",
    "onCommand:dreamshader.addPackageStoreIndex",
    "onCommand:dreamshader.removePackageStoreIndex",
    "onCommand:dreamshader.createPackage",
    "onCommand:dreamshader.createMaterial",
    "onCommand:dreamshader.createFunctionFile",
    "onCommand:dreamshader.createHeader",
    "onCommand:dreamshader.createTextureSample",
    "onCommand:dreamshader.createNoiseMaterial",
    "onLanguage:dreamshader-dss",
    "onCommand:dreamshader.revealInMaterialEditor",
    "onLanguage:dreamshader-dsp"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dreamshader.showBridgeDiagnostics",
        "title": "DreamShaderLang: Show Bridge Panel",
        "icon": "$(pulse)"
      },
      {
        "command": "dreamshader.recompileCurrent",
        "title": "DreamShaderLang: Recompile Current Source",
        "icon": "$(play)"
      },
      {
        "command": "dreamshader.recompileAll",
        "title": "DreamShaderLang: Recompile All Sources",
        "icon": "$(sync)"
      },
      {
        "command": "dreamshader.cleanGeneratedShaders",
        "title": "DreamShaderLang: Clean Generated Shaders",
        "icon": "$(trash)"
      },
      {
        "command": "dreamshader.showMaterialPreview",
        "title": "DreamShaderLang: Show Material Preview",
        "icon": "$(preview)"
      },
      {
        "command": "dreamshader.showMaterialDetails",
        "title": "DreamShaderLang: Show Details",
        "icon": "$(checklist)"
      },
      {
        "command": "dreamshader.revealInMaterialEditor",
        "title": "DreamShaderLang: Reveal in Material Editor",
        "icon": "$(target)"
      },
      {
        "command": "dreamshader.refreshBridgeDiagnostics",
        "title": "DreamShaderLang: Refresh Bridge Diagnostics",
        "icon": "$(refresh)"
      },
      {
        "command": "dreamshader.openBridgeDiagnosticLocation",
        "title": "DreamShaderLang: Open Bridge Diagnostic",
        "icon": "$(link-external)"
      },
      {
        "command": "dreamshader.installPackageFromGitHub",
        "title": "DreamShaderLang: Install Package from GitHub",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dreamshader.browsePackages",
        "title": "DreamShaderLang: Browse Package Store",
        "icon": "$(package)"
      },
      {
        "command": "dreamshader.updatePackages",
        "title": "DreamShaderLang: Update Installed Packages",
        "icon": "$(sync)"
      },
      {
        "command": "dreamshader.removePackage",
        "title": "DreamShaderLang: Remove Installed Package",
        "icon": "$(trash)"
      },
      {
        "command": "dreamshader.openPackagesFolder",
        "title": "DreamShaderLang: Open Packages Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dreamshader.addPackageStoreIndex",
        "title": "DreamShaderLang: Add Package Store Index Source",
        "icon": "$(add)"
      },
      {
        "command": "dreamshader.removePackageStoreIndex",
        "title": "DreamShaderLang: Remove Package Store Index Source",
        "icon": "$(remove)"
      },
      {
        "command": "dreamshader.createPackage",
        "title": "DreamShaderLang: Create Package Step by Step",
        "icon": "$(package)"
      },
      {
        "command": "dreamshader.createMaterial",
        "title": "DreamShaderLang: Create DreamShader Material",
        "icon": "$(new-file)"
      },
      {
        "command": "dreamshader.createFunctionFile",
        "title": "DreamShaderLang: Create DreamShader Function File",
        "icon": "$(symbol-method)"
      },
      {
        "command": "dreamshader.createHeader",
        "title": "DreamShaderLang: Create DreamShader Header",
        "icon": "$(file-code)"
      },
      {
        "command": "dreamshader.createTextureSample",
        "title": "DreamShaderLang: Create DreamShader Texture Sample",
        "icon": "$(file-media)"
      },
      {
        "command": "dreamshader.createNoiseMaterial",
        "title": "DreamShaderLang: Create DreamShader Noise Material",
        "icon": "$(symbol-event)"
      }
    ],
    "languages": [
      {
        "id": "dreamshaderlang",
        "aliases": [
          "DreamShaderLang",
          "dreamshaderlang",
          "DreamShader",
          "dreamshader",
          "dsm",
          "dsf",
          "dsh"
        ],
        "extensions": [
          ".dsm",
          ".dsf",
          ".dsh"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "dreamshader-dss",
        "aliases": [
          "DreamShader 2.0",
          "DreamShaderLang 2.0",
          "dss",
          "dsi"
        ],
        "extensions": [
          ".dss",
          ".dsi"
        ],
        "configuration": "./language-configuration-dss.json"
      },
      {
        "id": "dreamshader-dsp",
        "aliases": [
          "DreamShader Pipeline",
          "DreamShader Custom Pass",
          "dsp"
        ],
        "extensions": [
          ".dsp"
        ],
        "configuration": "./language-configuration-dss.json"
      }
    ],
    "grammars": [
      {
        "language": "dreamshaderlang",
        "scopeName": "source.dreamshaderlang",
        "path": "./syntaxes/dreamshader.tmLanguage.json"
      },
      {
        "language": "dreamshader-dss",
        "scopeName": "source.dreamshader.dss",
        "path": "./syntaxes/dreamshader-dss.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.hlsl": "hlsl"
        }
      },
      {
        "language": "dreamshader-dsp",
        "scopeName": "source.dreamshader.dsp",
        "path": "./syntaxes/dreamshader-dsp.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.hlsl": "hlsl"
        }
      }
    ],
    "breakpoints": [
      {
        "language": "dreamshaderlang"
      },
      {
        "language": "dreamshader-dss"
      }
    ],
    "snippets": [
      {
        "language": "dreamshaderlang",
        "path": "./snippets/dreamshader.code-snippets"
      },
      {
        "language": "dreamshader-dss",
        "path": "./snippets/dreamshader-dss.code-snippets"
      },
      {
        "language": "dreamshader-dsp",
        "path": "./snippets/dreamshader-dsp.code-snippets"
      }
    ],
    "configuration": {
      "title": "DreamShaderLang",
      "properties": {
        "dreamshader.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Optional Unreal project root used for DreamShaderLang bridge files. Leave empty to auto-detect from the active .dsm/.dsf/.dsh file or workspace."
        },
        "dreamshader.materialExpressionManifestPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to Saved/DreamShader/Bridge/material-expressions.json. Leave empty to use the active project's bridge manifest and the bundled fallback."
        },
        "dreamshader.packageStoreIndexUrls": {
          "type": "array",
          "default": [
            "https://raw.githubusercontent.com/TypeDreamMoon/dreamshader-package-index/main/packages.json"
          ],
          "items": {
            "type": "string"
          },
          "description": "Package store index sources. Each source should be a packages.json URL or local file path."
        },
        "dreamshader.packageStoreIndexUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/TypeDreamMoon/dreamshader-package-index/main/packages.json",
          "description": "Deprecated single package store index URL. Prefer dreamshader.packageStoreIndexUrls."
        },
        "dreamshader.enableGitHubPackageSearch": {
          "type": "boolean",
          "default": true,
          "description": "Include public GitHub repositories tagged with dreamshader-package when browsing DreamShader packages."
        },
        "dreamshader.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the DreamShaderLang status bar item for the active .dsm/.dsf/.dsh document."
        },
        "dreamshader.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show DreamShaderLang CodeLens actions such as Recompile Current / Recompile All above Shader, ShaderFunction, ShaderLayer, and ShaderLayerBlend blocks."
        },
        "dreamshader.previewWebSocketPort": {
          "type": "number",
          "default": 17864,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local Unreal Editor WebSocket port used by the DreamShader material preview."
        },
        "dreamshader.previewAutoRefreshDelayMs": {
          "type": "number",
          "default": 1200,
          "minimum": 250,
          "maximum": 10000,
          "description": "Delay before auto-saving and refreshing the active .dsm material preview after edits."
        },
        "dreamshader.previewTransport": {
          "type": "string",
          "default": "websocket",
          "enum": [
            "websocket",
            "file"
          ],
          "description": "Transport used for material preview requests. WebSocket falls back to the file bridge when unavailable."
        },
        "dreamshader.previewLiveFrameRate": {
          "type": "number",
          "default": 12,
          "minimum": 0,
          "maximum": 60,
          "description": "Maximum streamed material preview frame rate. Raw RGBA frames make higher rates cheap; set to 0 to pause continuous live frames. Only applies to the WebSocket transport."
        },
        "dreamshader.preprocessor.dimInactiveRegions": {
          "type": "boolean",
          "default": true,
          "description": "Fade the #if branches the project's preprocessor defines cut. Nothing is faded until the active project's bridge has exported its define table."
        },
        "dreamshader.preprocessor.inactiveOpacity": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Opacity of a faded inactive #if branch. 1 disables the fade without turning the feature off."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "dreamshaderBridge",
          "title": "DreamShader Bridge",
          "icon": "resources/dreamshader-bridge.svg"
        }
      ]
    },
    "views": {
      "dreamshaderBridge": [
        {
          "id": "dreamshader.bridgeDiagnostics",
          "name": "Diagnostics"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "dreamshader.recompileCurrent",
          "when": "(resourceLangId == dreamshaderlang || resourceLangId == dreamshader-dss || resourceLangId == dreamshader-dsp)",
          "group": "navigation@1"
        },
        {
          "command": "dreamshader.browsePackages",
          "when": "resourceLangId == dreamshaderlang",
          "group": "navigation@2"
        },
        {
          "command": "dreamshader.showMaterialPreview",
          "when": "(resourceLangId == dreamshaderlang && resourceExtname == .dsm) || resourceExtname == .dss",
          "group": "navigation@3"
        },
        {
          "command": "dreamshader.showMaterialDetails",
          "when": "resourceLangId == dreamshaderlang",
          "group": "navigation@4"
        },
        {
          "command": "dreamshader.cleanGeneratedShaders",
          "when": "(resourceLangId == dreamshaderlang || resourceLangId == dreamshader-dss || resourceLangId == dreamshader-dsp)",
          "group": "navigation@5"
        },
        {
          "command": "dreamshader.showBridgeDiagnostics",
          "when": "(resourceLangId == dreamshaderlang || resourceLangId == dreamshader-dss || resourceLangId == dreamshader-dsp)",
          "group": "navigation@6"
        },
        {
          "command": "dreamshader.revealInMaterialEditor",
          "when": "resourceExtname == .dss",
          "group": "navigation@7"
        }
      ],
      "editor/context": [
        {
          "command": "dreamshader.recompileCurrent",
          "when": "(resourceLangId == dreamshaderlang || resourceLangId == dreamshader-dss || resourceLangId == dreamshader-dsp)",
          "group": "navigation@1"
        },
        {
          "command": "dreamshader.showMaterialPreview",
          "when": "(resourceLangId == dreamshaderlang && resourceExtname == .dsm) || resourceExtname == .dss",
          "group": "navigation@2"
        },
        {
          "command": "dreamshader.showMaterialDetails",
          "when": "resourceLangId == dreamshaderlang",
          "group": "navigation@3"
        },
        {
          "command": "dreamshader.cleanGeneratedShaders",
          "when": "(resourceLangId == dreamshaderlang || resourceLangId == dreamshader-dss || resourceLangId == dreamshader-dsp)",
          "group": "navigation@4"
        },
        {
          "command": "dreamshader.revealInMaterialEditor",
          "when": "resourceExtname == .dss",
          "group": "navigation@5"
        }
      ],
      "view/title": [
        {
          "command": "dreamshader.refreshBridgeDiagnostics",
          "when": "view == dreamshader.bridgeDiagnostics",
          "group": "navigation@1"
        },
        {
          "command": "dreamshader.recompileAll",
          "when": "view == dreamshader.bridgeDiagnostics",
          "group": "navigation@2"
        },
        {
          "command": "dreamshader.cleanGeneratedShaders",
          "when": "view == dreamshader.bridgeDiagnostics",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dreamshader.openBridgeDiagnosticLocation",
          "when": "view == dreamshader.bridgeDiagnostics && viewItem == dreamshaderBridgeFile",
          "group": "inline@1"
        },
        {
          "command": "dreamshader.openBridgeDiagnosticLocation",
          "when": "view == dreamshader.bridgeDiagnostics && viewItem == dreamshaderBridgeDiagnostic",
          "group": "inline@1"
        },
        {
          "command": "dreamshader.openBridgeDiagnosticLocation",
          "when": "view == dreamshader.bridgeDiagnostics && viewItem == dreamshaderBridgeMeta",
          "group": "inline@1"
        }
      ]
    }
  },
  "scripts": {
    "test:language": "node scripts/language-smoke.js",
    "test:imports": "node scripts/imports-smoke.js",
    "test:preprocessor": "node scripts/preprocessor-smoke.js",
    "test:server": "node scripts/server-smoke.js",
    "test:corpus": "node scripts/corpus-smoke.js",
    "test:extension": "node scripts/run-extension-tests.js",
    "test": "npm run test:language && npm run test:imports && npm run test:preprocessor && npm run test:server && npm run test:corpus && npm run test:dss && npm run test:dsp && npm run test:grammar && npm run test:extension",
    "package": "npx @vscode/vsce package",
    "test:dss": "node scripts/dss-smoke.js",
    "test:dsp": "node scripts/dsp-smoke.js",
    "test:grammar": "vscode-tmgrammar-test -g test/grammar/hlsl.tmLanguage.json \"test/grammar/unit/*.test.*\" && vscode-tmgrammar-snap -g test/grammar/hlsl.tmLanguage.json \"test/grammar/snap/*.{dsp,dss}\""
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "sql.js": "^1.14.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.1.0"
  }
}
