{
  "DreamShader ShaderTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "ShaderTemplate",
    "body": [
      "Shader(Name=\"Materials/${1:M_Surface}\", Root=\"${2:Game}\")",
      "{",
      "\tProperties = {",
      "\t\tVectorParameter ${3:BaseColor} = float4(0.8, 0.8, 0.8, 1.0) [",
      "\t\t\tGroup=\"Surface\";",
      "\t\t\tSortPriority=10;",
      "\t\t];",
      "\t\tScalarParameter ${4:Roughness} = 0.55 [",
      "\t\t\tGroup=\"Surface\";",
      "\t\t\tSortPriority=20;",
      "\t\t];",
      "\t\tScalarParameter ${5:Metallic} = 0.0 [",
      "\t\t\tGroup=\"Surface\";",
      "\t\t\tSortPriority=30;",
      "\t\t];",
      "\t}",
      "",
      "\tSettings = {",
      "\t\tDomain = \"Surface\";",
      "\t\tShadingModel = \"DefaultLit\";",
      "\t\tBlendMode = \"Opaque\";",
      "\t}",
      "",
      "\tOutputs = {",
      "\t\tfloat3 Color;",
      "\t\tfloat Rough;",
      "\t\tfloat Metal;",
      "\t\tBase.BaseColor = Color;",
      "\t\tBase.Roughness = Rough;",
      "\t\tBase.Metallic = Metal;",
      "\t}",
      "",
      "\tGraph = {",
      "\t\tColor = ${3:BaseColor}.rgb;",
      "\t\tRough = ${4:Roughness};",
      "\t\tMetal = ${5:Metallic};",
      "\t}",
      "}"
    ],
    "description": "Create a DreamShader material block for a .dsm file"
  },
  "DreamShader FunctionTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "FunctionTemplate",
    "body": [
      "Function ${1:ApplyTint}(in float3 color, in float3 tint, out float3 result) {",
      "\tresult = color * tint;",
      "}"
    ],
    "description": "Create a reusable DreamShader Function block"
  },
  "DreamShader SelfContainedFunctionTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "SelfContainedFunctionTemplate",
    "body": [
      "Function SelfContained ${1:MyFunction}(in ${2:vec2} ${3:uv}, out ${4:vec4} ${5:result}) {",
      "\t${5:result} = ${4:vec4}(0.0, 0.0, 0.0, 1.0);",
      "}"
    ],
    "description": "Create a SelfContained DreamShader Function block"
  },
  "DreamShader NamespaceTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "NamespaceTemplate",
    "body": [
      "Namespace(Name=\"${1:Common}\")",
      "{",
      "\tFunction ${2:MyFunction}(in ${3:vec3} ${4:input}, out ${5:vec3} ${6:result}) {",
      "\t\t${6:result} = ${4:input};",
      "\t}",
      "}"
    ],
    "description": "Create a DreamShader Namespace block containing shared Functions"
  },
  "DreamShader ImportTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "ImportTemplate",
    "body": [
      "import \"${1:Shared/Common.dsh}\";"
    ],
    "description": "Import a DreamShader header file"
  },
  "DreamShader Import Package": {
    "scope": "dreamshaderlang",
    "prefix": "importpkg",
    "body": [
      "import \"@${1:scope}/${2:package}/Library/${3:Header}.dsh\";"
    ],
    "description": "Import a DreamShader package header file"
  },
  "DreamShader ShaderFunctionTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "ShaderFunctionTemplate",
    "body": [
      "ShaderFunction(Name=\"Functions/${1:F_Tint}\", Root=\"${2:Game}\")",
      "{",
      "\tInputs = {",
      "\t\tfloat3 ${3:Color};",
      "\t\topt float3 ${4:Tint} = float3(1.0, 1.0, 1.0);",
      "\t\topt float ${5:Strength} = 1.0;",
      "\t}",
      "",
      "\tOutputs = {",
      "\t\tfloat3 ${6:Result};",
      "\t}",
      "",
      "\tGraph = {",
      "\t\t${6:Result} = lerp(${3:Color}, ${3:Color} * ${4:Tint}, saturate(${5:Strength}));",
      "\t}",
      "}"
    ],
    "description": "Create a DreamShader MaterialFunction asset"
  },
  "DreamShader GraphFunctionTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "GraphFunctionTemplate",
    "body": [
      "GraphFunction ${1:TimePulse}(in float2 uv, out float pulse) {",
      "\tfloat t = UE.Time();",
      "\tpulse = saturate(0.5 + 0.5 * sin(uv.x * ${2:8.0} + t));",
      "}"
    ],
    "description": "Create a DreamShader GraphFunction Custom node helper"
  },
  "DreamShader ShaderLayerTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "ShaderLayerTemplate",
    "body": [
      "ShaderLayer(Name=\"Layers/${1:L_Surface}\", Root=\"${2:Game}\")",
      "{",
      "\tProperties = {",
      "\t\tVectorParameter ${3:BaseColor} = float4(0.8, 0.8, 0.8, 1.0) [",
      "\t\t\tGroup=\"Layer\";",
      "\t\t\tSortPriority=10;",
      "\t\t];",
      "\t\tScalarParameter ${4:Roughness} = 0.55 [",
      "\t\t\tGroup=\"Layer\";",
      "\t\t\tSortPriority=20;",
      "\t\t];",
      "\t\tScalarParameter ${5:Metallic} = 0.0 [",
      "\t\t\tGroup=\"Layer\";",
      "\t\t\tSortPriority=30;",
      "\t\t];",
      "\t}",
      "",
      "\tOutputs = {",
      "\t\tMaterialAttributes ${6:Attrs};",
      "\t}",
      "",
      "\tGraph = {",
      "\t\t${6:Attrs}.BaseColor = ${3:BaseColor}.rgb;",
      "\t\t${6:Attrs}.Opacity = ${3:BaseColor}.a;",
      "\t\t${6:Attrs}.Roughness = ${4:Roughness};",
      "\t\t${6:Attrs}.Metallic = ${5:Metallic};",
      "\t}",
      "}"
    ],
    "description": "Create a native Unreal Material Layer function asset"
  },
  "DreamShader ShaderLayerBlendTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "ShaderLayerBlendTemplate",
    "body": [
      "ShaderLayerBlend(Name=\"Layers/${1:LB_AlphaBlend}\", Root=\"${2:Game}\")",
      "{",
      "\tInputs = {",
      "\t\tMaterialAttributes ${3:Base};",
      "\t\tMaterialAttributes ${4:Layer};",
      "\t\topt float ${5:Alpha} = 1.0;",
      "\t}",
      "",
      "\tOutputs = {",
      "\t\tMaterialAttributes ${6:Result};",
      "\t}",
      "",
      "\tGraph = {",
      "\t\tfloat alpha = saturate(${5:Alpha});",
      "\t\t${6:Result} = ${3:Base};",
      "\t\t${6:Result}.BaseColor = lerp(${3:Base}.BaseColor, ${4:Layer}.BaseColor, alpha);",
      "\t\t${6:Result}.Roughness = lerp(${3:Base}.Roughness, ${4:Layer}.Roughness, alpha);",
      "\t\t${6:Result}.Metallic = lerp(${3:Base}.Metallic, ${4:Layer}.Metallic, alpha);",
      "\t\t${6:Result}.Opacity = lerp(${3:Base}.Opacity, ${4:Layer}.Opacity, alpha);",
      "\t}",
      "}"
    ],
    "description": "Create a native Unreal Material Layer Blend function asset"
  },
  "DreamShader VirtualFunctionTemplate": {
    "scope": "dreamshaderlang",
    "prefix": "VirtualFunctionTemplate",
    "body": [
      "VirtualFunction(Name=\"${1:MyFunction}\")",
      "{",
      "\tOptions = {",
      "\t\tAsset = Path(Plugins.${2:PluginName}, \"${3:MaterialFunctions/MyFunction}\");",
      "\t}",
      "",
      "\tInputs = {",
      "\t\t${4:float} ${5:Value};",
      "\t}",
      "",
      "\tOutputs = {",
      "\t\t${6:float} ${7:Result};",
      "\t}",
      "}"
    ],
    "description": "Declare an existing Unreal MaterialFunction asset for DreamShader Graph calls"
  },
  "DreamShader Graph Block": {
    "scope": "dreamshaderlang",
    "prefix": "graphblock",
    "body": [
      "Graph = {",
      "\t$0",
      "}"
    ],
    "description": "Create a Graph block"
  },
  "DreamShader UE Panner": {
    "scope": "dreamshaderlang",
    "prefix": "uepanner",
    "body": [
      "UE.Panner(",
      "\tCoordinate=UE.TexCoord(Index=${1:0}),",
      "\tTime=UE.Time(Period=${2:4.0}),",
      "\tSpeed=float2(${3:0.05}, ${4:0.0}))"
    ],
    "description": "Insert a UE.Panner call"
  },
  "DreamShader Generic Expression": {
    "scope": "dreamshaderlang",
    "prefix": "ueexpr",
    "body": [
      "UE.Expression(",
      "\tClass=\"${1:Sine}\",",
      "\tOutputType=\"${2:float1}\",",
      "\t${3:Input}=${4:Value})"
    ],
    "description": "Insert a generic reflected MaterialExpression call"
  },
  "DreamShader Optional Function Input": {
    "scope": "dreamshaderlang",
    "prefix": "optinput",
    "body": [
      "opt ${1:float4} ${2:Color} = ${3:float4(1.0, 1.0, 1.0, 1.0)} [",
      "\tDescription=\"${4:Optional input}\";",
      "\tSortPriority=${5:32};",
      "];"
    ],
    "description": "Insert an optional ShaderFunction / VirtualFunction input"
  },
  "DreamShader Static Switch Parameter": {
    "scope": "dreamshaderlang",
    "prefix": "staticswitch",
    "body": [
      "StaticSwitchParameter ${1:UseDetail} = ${2:true} [",
      "\tGroup=\"${3:Switches}\";",
      "\tSortPriority=${4:32};",
      "\tDescription=\"${5:Use detail branch}\";",
      "];"
    ],
    "description": "Insert a StaticSwitchParameter property"
  },
  "DreamShader Const Property": {
    "scope": "dreamshaderlang",
    "prefix": "constprop",
    "body": [
      "const ${1:float} ${2:Value} = ${3:0.0};"
    ],
    "description": "Insert a const DreamShader Properties declaration"
  },
  "DreamShader Collection Param": {
    "scope": "dreamshaderlang",
    "prefix": "collectionparam",
    "body": [
      "UE.CollectionParam(Collection=Path(${1:Game}, ${2:MaterialParameterCollections/MPC_Global}), Parameter=\"${3:Value}\")"
    ],
    "description": "Insert a MaterialParameterCollection read"
  },
  "DreamShader Declaration Metadata": {
    "scope": "dreamshaderlang",
    "prefix": "metadata",
    "body": [
      "[",
      "\tGroup=\"${1:General}\";",
      "\tSortPriority=${2:32};",
      "\tDescription=\"${3:Description}\";",
      "]"
    ],
    "description": "Insert DreamShader reflected declaration properties"
  },
  "DreamShader Texture Sample Parameter Reflection": {
    "scope": "dreamshaderlang",
    "prefix": "texparam",
    "body": [
      "TextureSampleParameter2D ${1:MetallicMap} = Path(${2:Game}, ${3:Textures/T_White_Linear}) [",
      "\tGroup=\"${4:11 - Specular}\";",
      "\tSortPriority=${5:51};",
      "\tSamplerType=\"${6:LinearColor}\";",
      "\tSamplerSource=\"${7:FromTextureAsset}\";",
      "\tMipValueMode=\"${8:None}\";",
      "\tAutomaticViewMipBias=${9:true};",
      "\tConstCoordinate=${10:0};",
      "\tConstMipValue=${11:-1};",
      "];"
    ],
    "description": "Insert a TextureSampleParameter2D with reflected properties"
  },
  "DreamShader Transform Vector": {
    "scope": "dreamshaderlang",
    "prefix": "uetransform",
    "body": [
      "UE.TransformVector(",
      "\tInput=${1:NormalTS},",
      "\tSource=\"${2:Tangent}\",",
      "\tDestination=\"${3:World}\")"
    ],
    "description": "Insert a UE.TransformVector call"
  },
  "DreamShader Material Attributes Output": {
    "scope": "dreamshaderlang",
    "prefix": "matattrs",
    "body": [
      "MaterialAttributes ${1:Attrs};",
      "Base.MaterialAttributes = ${1:Attrs};"
    ],
    "description": "Declare and fill a MaterialAttributes output"
  },
  "DreamShader MaterialAttributes Member": {
    "scope": "dreamshaderlang",
    "prefix": "attrmember",
    "body": [
      "${1:Attrs}.${2|BaseColor,Roughness,Metallic,Specular,Normal,Opacity,EmissiveColor,AmbientOcclusion|} = ${3:Value};"
    ],
    "description": "Assign a MaterialAttributes member in Graph"
  },
  "DreamShader Output Node Binding": {
    "scope": "dreamshaderlang",
    "prefix": "ueoutputpin",
    "body": [
      "Expression(Class=\"${1:ThinTranslucentMaterialOutput}\").Pin[${2:0}] = ${3:float3(0.8, 0.9, 1.0)};"
    ],
    "description": "Insert an auxiliary material output node binding"
  }
}

