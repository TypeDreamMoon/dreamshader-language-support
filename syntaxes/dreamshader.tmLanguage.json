{
  "scopeName": "source.dreamshaderlang",
  "name": "DreamShaderLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessorDirectives" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#sectionBlocks" },
    { "include": "#functionDefinitions" },
    { "include": "#topLevelKeywords" },
    { "include": "#booleans" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.dreamshader", "match": "//.*$" },
        { "name": "comment.block.dreamshader", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dreamshader",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.dreamshader", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.dreamshader", "match": "\\b-?(?:\\d+\\.\\d+|\\d+|\\.\\d+)(?:[fF])?\\b" }
      ]
    },
    "booleans": {
      "patterns": [
        { "name": "constant.language.boolean.dreamshader", "match": "\\b(?:true|false)\\b" }
      ]
    },
    "topLevelKeywords": {
      "patterns": [
        { "name": "keyword.control.dreamshader", "match": "\\b(?:Template|Shader|Namespace|Function|GraphFunction|ShaderFunction|ShaderLayer|ShaderLayerBlend|VirtualFunction|import)\\b" },
        { "name": "storage.modifier.function.dreamshader", "match": "\\b(?:SelfContained|Inline)\\b" },
        { "name": "entity.name.namespace.definition.dreamshader", "match": "(?<=\\bNamespace\\s*\\(\\s*Name\\s*=\\s*\")[A-Za-z_][A-Za-z0-9_]*\\b" },
        { "name": "variable.parameter.key.dreamshader", "match": "\\b(?:Name|Root|Asset)\\b(?=\\s*=)" }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "name": "meta.template.body.dreamshader",
          "begin": "\\b(Template)\\s+(Shader|ShaderFunction|ShaderLayer|ShaderLayerBlend)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.dreamshader" },
            "2": { "name": "keyword.control.dreamshader" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#sectionBlocks" },
            { "include": "#topLevelKeywords" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        },
        {
          "name": "meta.function.body.dreamshader",
          "comment": "No `#preprocessorDirectives` here, and that omission is the feature: this body is raw HLSL, its `#` lines address the shader compiler's preprocessor, and DreamShader's preprocessor does not descend into it.",
          "begin": "\\b(Function|GraphFunction)\\b(?:\\s+(SelfContained|Inline))?\\s+(?:([A-Za-z_][A-Za-z0-9_]*)\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\()",
          "beginCaptures": {
            "1": { "name": "keyword.control.dreamshader" },
            "2": { "name": "storage.modifier.function.dreamshader" },
            "3": { "name": "storage.type.dreamshader" },
            "4": { "name": "entity.name.function.definition.dreamshader" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#shaderKeywords" },
            { "include": "#types" },
            { "include": "#hlslIntrinsics" },
            { "include": "#namespaceCalls" },
            { "include": "#functionCalls" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "sectionBlocks": {
      "patterns": [
        { "include": "#propertiesSection" },
        { "include": "#inputsSection" },
        { "include": "#outputsSection" },
        { "include": "#graphSection" },
        { "include": "#layoutSection" },
        { "include": "#settingsSection" },
        { "include": "#optionsSection" }
      ]
    },
    "propertiesSection": {
      "patterns": [
        {
          "name": "meta.section.properties.dreamshader",
          "begin": "\\b(Properties)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#graphRegionDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#propertyGroupBlock" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#declarationMetadataKeys" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "inputsSection": {
      "patterns": [
        {
          "name": "meta.section.inputs.dreamshader",
          "begin": "\\b(Inputs)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#graphRegionDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#propertyGroupBlock" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#functionQualifiers" },
            { "include": "#declarationMetadataKeys" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "outputsSection": {
      "patterns": [
        {
          "name": "meta.section.outputs.dreamshader",
          "begin": "\\b(Outputs)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#materialOutputs" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "graphSection": {
      "patterns": [
        {
          "name": "meta.section.graph.dreamshader",
          "begin": "\\b(Graph)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#shaderKeywords" },
            { "include": "#ueCalls" },
            { "include": "#types" },
            { "include": "#graphNestedBlock" },
            { "include": "#hlslIntrinsics" },
            { "include": "#namespaceCalls" },
            { "include": "#functionCalls" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "graphNestedBlock": {
      "patterns": [
        {
          "name": "meta.block.graph.dreamshader",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#shaderKeywords" },
            { "include": "#ueCalls" },
            { "include": "#types" },
            { "include": "#graphNestedBlock" },
            { "include": "#hlslIntrinsics" },
            { "include": "#namespaceCalls" },
            { "include": "#functionCalls" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "propertyGroupBlock": {
      "patterns": [
        {
          "name": "meta.block.property-group.dreamshader",
          "begin": "\\b(Group)\\b\\s*(\\([^)]*\\))",
          "beginCaptures": {
            "1": { "name": "keyword.control.group.dreamshader" },
            "2": { "name": "string.quoted.double.group-name.dreamshader" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#propertyGroupBlock" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#declarationMetadataKeys" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "layoutSection": {
      "patterns": [
        {
          "name": "meta.section.layout.dreamshader",
          "begin": "\\b(Layout)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#layoutCalls" },
            { "include": "#types" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "settingsSection": {
      "patterns": [
        {
          "name": "meta.section.settings.dreamshader",
          "begin": "\\b(Settings)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#settings" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "optionsSection": {
      "patterns": [
        {
          "name": "meta.section.options.dreamshader",
          "begin": "\\b(Options)\\b\\s*=?",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorDirectives" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#settings" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "shaderKeywords": {
      "patterns": [
        { "name": "keyword.control.shadercode.dreamshader", "match": "\\b(?:if|else|for|while|do|switch|case|default|break|continue|return)\\b" },
        { "name": "storage.modifier.shadercode.dreamshader", "match": "\\b(?:const|static|in|out|inout|struct|opt)\\b" }
      ]
    },
    "functionQualifiers": {
      "patterns": [
        { "name": "storage.modifier.shadercode.dreamshader", "match": "\\b(?:in|out|inout|opt|const)\\b" }
      ]
    },
    "declarationLines": {
      "patterns": [
        {
          "name": "meta.declaration.dreamshader",
          "match": "\\b(?:(opt|const)\\s+)?((?:float|float1|float2|float3|float4|float2x2|float3x3|float4x4|half|half1|half2|half3|half4|int|int2|int3|int4|uint|uint2|uint3|uint4|bool|bool2|bool3|bool4|Texture2D|TextureCube|Texture2DArray|VolumeTexture|Texture3D|SamplerState|MaterialAttributes|Substrate|SubstrateBSDF|SubstrateMaterial|SubstrateSlab|SubstrateClosure|Strata|StrataBSDF|StrataMaterial|StrataSlab|StrataClosure|ScalarParameter|VectorParameter|DoubleVectorParameter|StaticBoolParameter|StaticSwitchParameter|TextureObjectParameter|TextureSampleParameter2D|TextureSampleParameter2DArray|TextureSampleParameterCube|TextureSampleParameterCubeArray|TextureSampleParameterVolume|TextureSampleParameterSubUV|RuntimeVirtualTextureSampleParameter|SparseVolumeTextureSampleParameter|SparseVolumeTextureObjectParameter|ChannelMaskParameter|StaticComponentMaskParameter|TextureCollectionParameter|CurveAtlasRowParameter|DynamicParameter|FontSampleParameter|SpriteTextureSampler|vec2|vec3|vec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|bvec2|bvec3|bvec4|mat2|mat3|mat4))\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.shadercode.dreamshader" },
            "2": { "name": "storage.type.dreamshader" },
            "3": { "name": "variable.other.declaration.dreamshader" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.dreamshader", "match": "\\b(?:float|float1|float2|float3|float4|float2x2|float3x3|float4x4|half|half1|half2|half3|half4|int|int2|int3|int4|uint|uint2|uint3|uint4|bool|bool2|bool3|bool4|void|Texture2D|TextureCube|Texture2DArray|VolumeTexture|Texture3D|SamplerState|MaterialAttributes|Substrate|SubstrateBSDF|SubstrateMaterial|SubstrateSlab|SubstrateClosure|Strata|StrataBSDF|StrataMaterial|StrataSlab|StrataClosure|ScalarParameter|VectorParameter|DoubleVectorParameter|StaticBoolParameter|StaticSwitchParameter|TextureObjectParameter|TextureSampleParameter2D|TextureSampleParameter2DArray|TextureSampleParameterCube|TextureSampleParameterCubeArray|TextureSampleParameterVolume|TextureSampleParameterSubUV|RuntimeVirtualTextureSampleParameter|SparseVolumeTextureSampleParameter|SparseVolumeTextureObjectParameter|ChannelMaskParameter|StaticComponentMaskParameter|TextureCollectionParameter|CurveAtlasRowParameter|DynamicParameter|FontSampleParameter|SpriteTextureSampler|vec2|vec3|vec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|bvec2|bvec3|bvec4|mat2|mat3|mat4)\\b" }
      ]
    },
    "declarationMetadataKeys": {
      "patterns": [
        { "name": "keyword.control.group.dreamshader", "match": "\\b(?:Group)\\b(?=\\s*\\()" },
        { "name": "support.function.attribute.dreamshader", "match": "\\b(?:Slider)\\b(?=\\s*\\()" },
        { "name": "variable.parameter.key.dreamshader", "match": "\\b(?:Group|Category|SortPriority|Sort|Description|Desc|Tooltip|DisplayName|ParameterName|DefaultValue|Curve|Atlas|CurveTime|UseCustomPrimitiveData|PrimitiveDataIndex|SamplerType|SamplerSource|MipValueMode|GatherMode|AutomaticViewMipBias|AutomaticViewMipBiasValue|Coordinates|MipValue|CoordinatesDX|CoordinatesDY|ConstCoordinate|ConstMipValue)\\b(?=\\s*=)" }
      ]
    },
    "graphRegionDirectives": {
      "patterns": [
        {
          "name": "meta.region.graph.dreamshader",
          "comment": "The parser matches these two words with ESearchCase::IgnoreCase, so `#region` in lower case is, and always was, legal. Matching them case-sensitively here was a grammar-only bug.",
          "match": "^\\s*(#(?i:(?:end)?region))\\b(?:\\s+(\"[^\"]*\"|[^\\r\\n]+))?",
          "captures": {
            "1": { "name": "keyword.control.region.dreamshader" },
            "2": { "name": "string.quoted.double.region-name.dreamshader" }
          }
        }
      ]
    },
    "preprocessorDirectives": {
      "comment": "The eight generation-time directives, line-oriented: the `#` may be preceded only by whitespace, may be followed by whitespace (`#  if FOO` is `#if FOO`), and the keyword is matched LOWERCASE ONLY -- `#IF` is DSH1035, not a directive. This rule is deliberately absent from `meta.function.body.dreamshader`: that body is raw HLSL addressed to the shader compiler's own preprocessor, and painting its `#include` / `#if` as DreamShader directives would be a lie. Every other patterns list gets it, because `#if` can cut any declaration -- a `Settings` line, an `Outputs` block, an `import`. A `#` line that is neither one of the eight keywords nor `#Region` / `#EndRegion` is DSH1035, but it is left unscoped rather than marked invalid: the function-body block ends at the first `}`, so HLSL lines past a nested brace can leak out here, and a false red mark is worse than a missing one.",
      "patterns": [
        { "include": "#preprocessorDefine" },
        { "include": "#preprocessorNameDirectives" },
        { "include": "#preprocessorConditionals" },
        { "include": "#preprocessorElseEndif" }
      ]
    },
    "preprocessorDefine": {
      "patterns": [
        {
          "name": "meta.preprocessor.define.dreamshader",
          "comment": "The value runs to end of line and is never tokenized, expanded or evaluated -- so it is left as plain text rather than highlighted as an expression. `#strings` comes before `#comments` to keep the trailing-comment strip quote-aware: `#define PP_URL \"http://x\"` keeps its whole string.",
          "begin": "^[ \\t]*(#[ \\t]*define)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*)\\b)?",
          "beginCaptures": {
            "1": { "name": "keyword.control.preprocessor.dreamshader" },
            "2": { "name": "entity.name.constant.preprocessor.dreamshader" }
          },
          "end": "$",
          "patterns": [
            { "include": "#strings" },
            { "include": "#comments" }
          ]
        }
      ]
    },
    "preprocessorNameDirectives": {
      "patterns": [
        {
          "name": "meta.preprocessor.dreamshader",
          "comment": "`#ifdef` / `#ifndef` / `#undef` -- one name operand. `#ifdef NAME` is exactly `#if defined(NAME)`.",
          "begin": "^[ \\t]*(#[ \\t]*(?:ifdef|ifndef|undef))\\b",
          "beginCaptures": { "1": { "name": "keyword.control.preprocessor.dreamshader" } },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#preprocessorBuiltinConstants" },
            { "name": "entity.name.constant.preprocessor.dreamshader", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },
    "preprocessorConditionals": {
      "patterns": [
        {
          "name": "meta.preprocessor.conditional.dreamshader",
          "comment": "`#if` / `#elif`. `\\b` after the keyword is what keeps this rule off `#ifdef`. `#comments` is first so a trailing `//` beats the `/` in `#operators`; the hex rule is before `#numbers`, which only knows decimals.",
          "begin": "^[ \\t]*(#[ \\t]*(?:if|elif))\\b",
          "beginCaptures": { "1": { "name": "keyword.control.preprocessor.dreamshader" } },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "name": "keyword.operator.defined.dreamshader", "match": "\\bdefined\\b" },
            { "include": "#preprocessorBuiltinConstants" },
            { "name": "constant.numeric.hex.dreamshader", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
            { "include": "#numbers" },
            { "include": "#preprocessorOperators" },
            { "include": "#operators" },
            { "name": "variable.other.constant.preprocessor.dreamshader", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },
    "preprocessorElseEndif": {
      "patterns": [
        {
          "comment": "`#else` / `#endif` take no operand at all. A stray token after one is DSH1042; it is left to the enclosing patterns rather than marked here.",
          "match": "^[ \\t]*(#[ \\t]*(?:else|endif))\\b",
          "captures": { "1": { "name": "keyword.control.preprocessor.dreamshader" } }
        }
      ]
    },
    "preprocessorBuiltinConstants": {
      "patterns": [
        { "name": "support.constant.builtin.dreamshader", "match": "\\b(?:DS_ENGINE_MAJOR|DS_ENGINE_MINOR|DS_ENGINE_PATCH|DS_PLATFORM|DS_PLUGIN_VERSION|DS_SUBSTRATE)\\b" }
      ]
    },
    "preprocessorOperators": {
      "comment": "The operators the conditional grammar has that `#operators` lacks. `!(?!=)` is what stops the logical rule from eating the `!` of a `!=`.",
      "patterns": [
        { "name": "keyword.operator.logical.dreamshader", "match": "&&|\\|\\||!(?!=)" },
        { "name": "keyword.operator.comparison.dreamshader", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.dreamshader", "match": "%" }
      ]
    },
    "layoutCalls": {
      "patterns": [
        { "name": "support.function.layout.dreamshader", "match": "\\b(?:Node|Comment)\\b(?=\\s*\\()" },
        { "name": "variable.parameter.key.dreamshader", "match": "\\b(?:Var|Name|X|Y|W|H|Color)\\b(?=\\s*=)" }
      ]
    },
    "pathHelpers": {
      "patterns": [
        { "name": "support.function.helper.dreamshader", "match": "\\bPath\\b(?=\\s*\\()" }
      ]
    },
    "settings": {
      "patterns": [
        { "name": "support.type.property-name.dreamshader", "match": "\\b(?:MaterialDomain|Domain|ShadingModel|BlendMode|RenderType|TwoSided|Wireframe|DitheredLODTransition|DitherOpacityMask|AllowNegativeEmissiveColor|CastDynamicShadowAsMasked|ResponsiveAA|ScreenSpaceReflections|ContactShadows|DisableDepthTest|OutputTranslucentVelocity|TangentSpaceNormal|FullyRough|IsSky|ThinSurface|HasPixelAnimation|OpacityMaskClipValue|NumCustomizedUVs|RefractionCoverageMode|SubstrateRoughnessTracking|Description|Desc|Group|Category|SortPriority|Sort|ExposeToLibrary|UserExposedCaption|LibraryCategories|Asset|OutputType|ResultType|Output|OutputName|OutputIndex|Class|ParameterName|DefaultValue|True|False|Default|DynamicBranch|Curve|Atlas|CurveTime|UseCustomPrimitiveData|PrimitiveDataIndex|SamplerType|SamplerSource|MipValueMode|GatherMode|AutomaticViewMipBias|ConstCoordinate|ConstMipValue)\\b(?=\\s*=)" }
      ]
    },
    "materialOutputs": {
      "patterns": [
        { "name": "variable.language.output.dreamshader", "match": "\\bBase\\s*\\.\\s*(?:MaterialAttributes|Attributes|FrontMaterial|BaseColor|EmissiveColor|Emissive|Opacity|OpacityMask|Metallic|Specular|Roughness|Normal|AmbientOcclusion|AO|Refraction|WorldPositionOffset|WPO|PixelDepthOffset|PDO|SubsurfaceColor|ClearCoat|ClearCoatRoughness|CustomData0|CustomData1|DiffuseColor|SpecularColor|SurfaceThickness|Displacement|CustomizedUV0|CustomizedUV1|CustomizedUV2|CustomizedUV3|CustomizedUV4|CustomizedUV5|CustomizedUV6|CustomizedUV7|CustomizedUVs0|CustomizedUVs1|CustomizedUVs2|CustomizedUVs3|CustomizedUVs4|CustomizedUVs5|CustomizedUVs6|CustomizedUVs7|MooaEncodedAttribute0|MooaEncodedAttribute1|MooaEncodedAttribute2|MooaEncodedAttribute3|MooaEncodedAttribute4|Anisotropy|Tangent)\\b(?=\\s*=)" },
        { "name": "support.class.output-root.dreamshader", "match": "\\bBase\\b(?=\\s*\\.)" },
        { "name": "support.function.output-node.dreamshader", "match": "\\bExpression\\b(?=\\s*\\()" },
        { "name": "variable.parameter.output-pin.dreamshader", "match": "\\bPin\\b(?=\\s*\\[)" }
      ]
    },
    "ueCalls": {
      "patterns": [
        { "name": "support.class.namespace.dreamshader", "match": "\\b(?:UE|Substrate)\\b(?=\\.)" },
        { "name": "support.function.ue.dreamshader", "match": "(?<=\\b(?:UE|Substrate)\\.)[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "hlslIntrinsics": {
      "patterns": [
        { "name": "support.function.hlsl.dreamshader", "match": "\\b(?:abs|acos|all|any|asin|atan|ceil|clip|cos|cosh|ddx|ddx_coarse|ddx_fine|ddy|ddy_coarse|ddy_fine|degrees|determinant|exp|exp2|floor|frac|fwidth|isfinite|isinf|isnan|length|lit|log|log10|log2|normalize|radians|round|rsqrt|saturate|sign|sin|sinh|sqrt|tan|tanh|transpose|trunc|atan2|cross|distance|dot|fmod|frexp|ldexp|max|min|modf|mul|pow|reflect|refract|clamp|lerp|smoothstep|step|sincos|mix|fract|mod|Texture2DSample|Texture2DSampleLevel|Texture2DSampleBias|Texture2DSampleGrad|Texture2DArraySample|Texture2DArraySampleLevel|TextureCubeSample|TextureCubeSampleLevel|Texture3DSample|Texture3DSampleLevel)\\b(?=\\s*\\()" }
      ]
    },
    "namespaceCalls": {
      "patterns": [
        { "name": "support.class.namespace.dreamshader", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=::[A-Za-z_])" },
        { "name": "punctuation.separator.scope-resolution.dreamshader", "match": "::" },
