{
  "scopeName": "source.dreamshaderlang",
  "name": "DreamShaderLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#sectionBlocks" },
    { "include": "#functionDefinitions" },
    { "include": "#topLevelKeywords" },
    { "include": "#booleans" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.dreamshader", "match": "//.*$" },
        { "name": "comment.block.dreamshader", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dreamshader",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.dreamshader", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.dreamshader", "match": "\\b-?(?:\\d+\\.\\d+|\\d+|\\.\\d+)(?:[fF])?\\b" }
      ]
    },
    "booleans": {
      "patterns": [
        { "name": "constant.language.boolean.dreamshader", "match": "\\b(?:true|false)\\b" }
      ]
    },
    "topLevelKeywords": {
      "patterns": [
        { "name": "keyword.control.dreamshader", "match": "\\b(?:Shader|Namespace|Function|GraphFunction|ShaderFunction|ShaderLayer|ShaderLayerBlend|VirtualFunction|import)\\b" },
        { "name": "storage.modifier.function.dreamshader", "match": "\\b(?:SelfContained|Inline)\\b" },
        { "name": "entity.name.namespace.definition.dreamshader", "match": "(?<=\\bNamespace\\s*\\(\\s*Name\\s*=\\s*\")[A-Za-z_][A-Za-z0-9_]*\\b" },
        { "name": "variable.parameter.key.dreamshader", "match": "\\b(?:Name|Root|Asset)\\b(?=\\s*=)" }
      ]
    },
    "functionDefinitions": {
      "patterns": [
        {
          "name": "meta.function.definition.dreamshader",
          "begin": "\\b(Function|GraphFunction)\\b(?:\\s+(SelfContained|Inline))?\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.dreamshader" },
            "2": { "name": "storage.modifier.function.dreamshader" },
            "3": { "name": "entity.name.function.definition.dreamshader" }
          },
          "end": "(?=\\{)|$",
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#types" },
            { "include": "#functionQualifiers" },
            { "include": "#operators" }
          ]
        },
        {
          "name": "meta.function.body.dreamshader",
          "begin": "\\b(Function|GraphFunction)\\b(?:\\s+(SelfContained|Inline))?\\s+([A-Za-z_][A-Za-z0-9_]*)\\b[^\\{]*\\{",
          "beginCaptures": {
            "1": { "name": "keyword.control.dreamshader" },
            "2": { "name": "storage.modifier.function.dreamshader" },
            "3": { "name": "entity.name.function.definition.dreamshader" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#shaderKeywords" },
            { "include": "#types" },
            { "include": "#hlslIntrinsics" },
            { "include": "#namespaceCalls" },
            { "include": "#functionCalls" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "sectionBlocks": {
      "patterns": [
        { "include": "#propertiesSection" },
        { "include": "#inputsSection" },
        { "include": "#outputsSection" },
        { "include": "#graphSection" },
        { "include": "#settingsSection" },
        { "include": "#optionsSection" }
      ]
    },
    "propertiesSection": {
      "patterns": [
        {
          "name": "meta.section.properties.dreamshader",
          "begin": "\\b(Properties)\\b\\s*=\\s*\\{",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#declarationMetadataKeys" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "inputsSection": {
      "patterns": [
        {
          "name": "meta.section.inputs.dreamshader",
          "begin": "\\b(Inputs)\\b\\s*=\\s*\\{",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#functionQualifiers" },
            { "include": "#declarationMetadataKeys" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "outputsSection": {
      "patterns": [
        {
          "name": "meta.section.outputs.dreamshader",
          "begin": "\\b(Outputs)\\b\\s*=\\s*\\{",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#materialOutputs" },
            { "include": "#declarationLines" },
            { "include": "#types" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "graphSection": {
      "patterns": [
        {
          "name": "meta.section.graph.dreamshader",
          "begin": "\\b(Graph)\\b\\s*=\\s*\\{",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#shaderKeywords" },
            { "include": "#types" },
            { "include": "#graphNestedBlock" },
            { "include": "#hlslIntrinsics" },
            { "include": "#ueCalls" },
            { "include": "#namespaceCalls" },
            { "include": "#functionCalls" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "graphNestedBlock": {
      "patterns": [
        {
          "name": "meta.block.graph.dreamshader",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#shaderKeywords" },
            { "include": "#types" },
            { "include": "#graphNestedBlock" },
            { "include": "#hlslIntrinsics" },
            { "include": "#ueCalls" },
            { "include": "#namespaceCalls" },
            { "include": "#functionCalls" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "settingsSection": {
      "patterns": [
        {
          "name": "meta.section.settings.dreamshader",
          "begin": "\\b(Settings)\\b\\s*=\\s*\\{",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#settings" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "optionsSection": {
      "patterns": [
        {
          "name": "meta.section.options.dreamshader",
          "begin": "\\b(Options)\\b\\s*=\\s*\\{",
          "beginCaptures": { "1": { "name": "entity.name.section.dreamshader" } },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#settings" },
            { "include": "#pathHelpers" },
            { "include": "#booleans" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "shaderKeywords": {
      "patterns": [
        { "name": "keyword.control.shadercode.dreamshader", "match": "\\b(?:if|else|for|while|do|switch|case|default|break|continue|return)\\b" },
        { "name": "storage.modifier.shadercode.dreamshader", "match": "\\b(?:const|static|in|out|inout|struct|opt)\\b" }
      ]
    },
    "functionQualifiers": {
      "patterns": [
        { "name": "storage.modifier.shadercode.dreamshader", "match": "\\b(?:in|out|inout|opt|const)\\b" }
      ]
    },
    "declarationLines": {
      "patterns": [
        {
          "name": "meta.declaration.dreamshader",
          "match": "\\b(?:(opt|const)\\s+)?((?:float|float1|float2|float3|float4|float2x2|float3x3|float4x4|half|half1|half2|half3|half4|int|int2|int3|int4|uint|uint2|uint3|uint4|bool|bool2|bool3|bool4|Texture2D|TextureCube|Texture2DArray|SamplerState|MaterialAttributes|Substrate|SubstrateBSDF|SubstrateMaterial|SubstrateSlab|SubstrateClosure|Strata|StrataBSDF|StrataMaterial|StrataSlab|StrataClosure|ScalarParameter|VectorParameter|DoubleVectorParameter|StaticBoolParameter|StaticSwitchParameter|TextureObjectParameter|TextureSampleParameter2D|TextureSampleParameter2DArray|TextureSampleParameterCube|TextureSampleParameterCubeArray|TextureSampleParameterVolume|TextureSampleParameterSubUV|RuntimeVirtualTextureSampleParameter|SparseVolumeTextureSampleParameter|SparseVolumeTextureObjectParameter|ChannelMaskParameter|StaticComponentMaskParameter|TextureCollectionParameter|CurveAtlasRowParameter|DynamicParameter|FontSampleParameter|SpriteTextureSampler|vec2|vec3|vec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|bvec2|bvec3|bvec4|mat2|mat3|mat4))\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.modifier.shadercode.dreamshader" },
            "2": { "name": "storage.type.dreamshader" },
            "3": { "name": "variable.other.declaration.dreamshader" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.dreamshader", "match": "\\b(?:float|float1|float2|float3|float4|float2x2|float3x3|float4x4|half|half1|half2|half3|half4|int|int2|int3|int4|uint|uint2|uint3|uint4|bool|bool2|bool3|bool4|void|Texture2D|TextureCube|Texture2DArray|SamplerState|MaterialAttributes|Substrate|SubstrateBSDF|SubstrateMaterial|SubstrateSlab|SubstrateClosure|Strata|StrataBSDF|StrataMaterial|StrataSlab|StrataClosure|ScalarParameter|VectorParameter|DoubleVectorParameter|StaticBoolParameter|StaticSwitchParameter|TextureObjectParameter|TextureSampleParameter2D|TextureSampleParameter2DArray|TextureSampleParameterCube|TextureSampleParameterCubeArray|TextureSampleParameterVolume|TextureSampleParameterSubUV|RuntimeVirtualTextureSampleParameter|SparseVolumeTextureSampleParameter|SparseVolumeTextureObjectParameter|ChannelMaskParameter|StaticComponentMaskParameter|TextureCollectionParameter|CurveAtlasRowParameter|DynamicParameter|FontSampleParameter|SpriteTextureSampler|vec2|vec3|vec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|bvec2|bvec3|bvec4|mat2|mat3|mat4)\\b" }
      ]
    },
    "declarationMetadataKeys": {
      "patterns": [
        { "name": "variable.parameter.key.dreamshader", "match": "\\b(?:Group|Category|SortPriority|Sort|Description|Desc|Tooltip|DisplayName|ParameterName|DefaultValue|Curve|Atlas|CurveTime|UseCustomPrimitiveData|PrimitiveDataIndex|SamplerType|SamplerSource|MipValueMode|GatherMode|AutomaticViewMipBias|AutomaticViewMipBiasValue|Coordinates|MipValue|CoordinatesDX|CoordinatesDY|ConstCoordinate|ConstMipValue)\\b(?=\\s*=)" }
      ]
    },
    "pathHelpers": {
      "patterns": [
        { "name": "support.function.helper.dreamshader", "match": "\\bPath\\b(?=\\s*\\()" }
      ]
    },
    "settings": {
      "patterns": [
        { "name": "support.type.property-name.dreamshader", "match": "\\b(?:MaterialDomain|Domain|ShadingModel|BlendMode|RenderType|TwoSided|Wireframe|DitheredLODTransition|DitherOpacityMask|AllowNegativeEmissiveColor|CastDynamicShadowAsMasked|ResponsiveAA|ScreenSpaceReflections|ContactShadows|DisableDepthTest|OutputTranslucentVelocity|TangentSpaceNormal|FullyRough|IsSky|ThinSurface|HasPixelAnimation|OpacityMaskClipValue|NumCustomizedUVs|RefractionCoverageMode|SubstrateRoughnessTracking|Description|Desc|Group|Category|SortPriority|Sort|ExposeToLibrary|UserExposedCaption|LibraryCategories|Asset|OutputType|ResultType|Output|OutputName|OutputIndex|Class|ParameterName|DefaultValue|True|False|Default|DynamicBranch|Curve|Atlas|CurveTime|UseCustomPrimitiveData|PrimitiveDataIndex|SamplerType|SamplerSource|MipValueMode|GatherMode|AutomaticViewMipBias|ConstCoordinate|ConstMipValue)\\b(?=\\s*=)" }
      ]
    },
    "materialOutputs": {
      "patterns": [
        { "name": "support.class.output-root.dreamshader", "match": "\\bBase\\b(?=\\s*\\.)" },
        { "name": "variable.language.output.dreamshader", "match": "\\bBase\\s*\\.\\s*(?:MaterialAttributes|Attributes|BaseColor|EmissiveColor|Emissive|Opacity|OpacityMask|Metallic|Specular|Roughness|Normal|AmbientOcclusion|AO|Refraction|WorldPositionOffset|WPO|PixelDepthOffset|PDO|SubsurfaceColor|ClearCoat|ClearCoatRoughness|CustomData0|CustomData1|DiffuseColor|SpecularColor|SurfaceThickness|Displacement|CustomizedUV0|CustomizedUV1|CustomizedUV2|CustomizedUV3|CustomizedUV4|CustomizedUV5|CustomizedUV6|CustomizedUV7|CustomizedUVs0|CustomizedUVs1|CustomizedUVs2|CustomizedUVs3|CustomizedUVs4|CustomizedUVs5|CustomizedUVs6|CustomizedUVs7|MooaEncodedAttribute0|MooaEncodedAttribute1|MooaEncodedAttribute2|MooaEncodedAttribute3|MooaEncodedAttribute4|Anisotropy|Tangent)\\b(?=\\s*=)" },
        { "name": "support.function.output-node.dreamshader", "match": "\\bExpression\\b(?=\\s*\\()" },
        { "name": "variable.parameter.output-pin.dreamshader", "match": "\\bPin\\b(?=\\s*\\[)" }
      ]
    },
    "ueCalls": {
      "patterns": [
        { "name": "support.class.namespace.dreamshader", "match": "\\bUE\\b(?=\\.)" },
        { "name": "support.function.ue.dreamshader", "match": "(?<=\\bUE\\.)[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "hlslIntrinsics": {
      "patterns": [
        { "name": "support.function.hlsl.dreamshader", "match": "\\b(?:abs|acos|all|any|asin|atan|atan2|ceil|clamp|clip|cos|cosh|cross|ddx|ddx_coarse|ddx_fine|ddy|ddy_coarse|ddy_fine|degrees|determinant|distance|dot|exp|exp2|floor|fmod|frac|fract|frexp|fwidth|isfinite|isinf|isnan|ldexp|length|lerp|lit|log|log10|log2|max|min|mix|mod|modf|mul|normalize|pow|radians|reflect|refract|round|rsqrt|saturate|sign|sin|sincos|sinh|smoothstep|sqrt|step|tan|tanh|transpose|trunc)\\b(?=\\s*\\()" }
      ]
    },
    "namespaceCalls": {
      "patterns": [
        { "name": "support.class.namespace.dreamshader", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=::[A-Za-z_])" },
        { "name": "punctuation.separator.scope-resolution.dreamshader", "match": "::" },
        { "name": "entity.name.function.dreamshader", "match": "(?<=::)[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()" }
      ]
    },
    "functionCalls": {
      "patterns": [
        { "name": "entity.name.function.dreamshader", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:(?:::|\\.)[A-Za-z_][A-Za-z0-9_]*)*\\b(?=\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.dreamshader", "match": "(::|=|\\+|\\-|\\*|/|\\.|,|;|\\[|\\])" }
      ]
    }
  }
}
